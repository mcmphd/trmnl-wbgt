<!--
  Half-horizontal (800x240 physical): full width, half height. Verdict
  sized down to leave room for the chip row within 240px of height.
-->

{% assign flag = work.flag %}
{% if flag == "black" %}
  {% assign f_bg = "#000000" %}{% assign f_fg = "#ffffff" %}
{% elsif flag == "red" %}
  {% assign f_bg = "#595959" %}{% assign f_fg = "#ffffff" %}
{% elsif flag == "yellow" %}
  {% assign f_bg = "#a6a6a6" %}{% assign f_fg = "#000000" %}
{% elsif flag == "green" %}
  {% assign f_bg = "#d9d9d9" %}{% assign f_fg = "#000000" %}
{% else %}
  {% assign f_bg = "#ffffff" %}{% assign f_fg = "#000000" %}
{% endif %}

<div class="view view--half_horizontal" style="width: 100%; height: 100%; box-sizing: border-box; padding: 16px 24px; font-family: sans-serif; display: flex; flex-direction: column; gap: 10px;">

  <div style="font-size: 34px; font-weight: 700; line-height: 1.15; flex: 1; display: flex; align-items: center;">
    {{ verdict }}
  </div>

  <div style="display: flex; flex-direction: row; flex-wrap: wrap; gap: 10px;">
    {% if storm.expected %}
      <div style="background: #000000; color: #ffffff; padding: 6px 12px; font-size: 14px;">
        Storms{% if storm.window_label %}, {{ storm.window_label }}{% endif %}
      </div>
    {% endif %}
    <div style="border: 1px solid #000; padding: 6px 12px; font-size: 14px;">
      Feels {{ feels_like.low_f | round }}–{{ feels_like.high_f | round }}&deg;F
    </div>
    {% if flag != "white" %}
      <div style="background: {{ f_bg }}; color: {{ f_fg }}; padding: 6px 12px; font-size: 14px;">
        WBGT {{ flag | capitalize }} ({{ work.wbgt_f | round }}&deg;F)
      </div>
    {% endif %}
    {% if wind.windy %}
      <div style="border: 1px solid #000; padding: 6px 12px; font-size: 14px;">
        Windy, gusts {{ wind.gust_mph | round }}mph
      </div>
    {% endif %}
    {% if sun.show %}
      <div style="border: 1px solid #000; padding: 6px 12px; font-size: 14px;">
        UV {{ sun.uv_index | round }}
      </div>
    {% endif %}
    {% if rain.action != "none" %}
      <div style="border: 1px solid #000; padding: 6px 12px; font-size: 14px;">
        {{ rain.max_pop_pct | round }}% rain{% if rain.window_label %}, {{ rain.window_label }}{% endif %}
      </div>
    {% endif %}
  </div>

  <div style="font-size: 10px; opacity: 0.5;">
    updated {{ generated_at | date: "%-I:%M %p" }}
  </div>
</div>
