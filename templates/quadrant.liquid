<!--
  Quadrant (400x240 physical): narrowest and shortest view. Verdict
  condensed further; footer timestamp dropped entirely for space, same
  tradeoff as the previous quadrant design.
-->

{% assign flag = work.flag %}
{% if flag == "black" %}
  {% assign f_bg = "#000000" %}{% assign f_fg = "#ffffff" %}
{% elsif flag == "red" %}
  {% assign f_bg = "#595959" %}{% assign f_fg = "#ffffff" %}
{% elsif flag == "yellow" %}
  {% assign f_bg = "#a6a6a6" %}{% assign f_fg = "#000000" %}
{% elsif flag == "green" %}
  {% assign f_bg = "#d9d9d9" %}{% assign f_fg = "#000000" %}
{% else %}
  {% assign f_bg = "#ffffff" %}{% assign f_fg = "#000000" %}
{% endif %}

<div class="view view--quadrant" style="width: 100%; height: 100%; box-sizing: border-box; padding: 12px 14px; font-family: sans-serif; display: flex; flex-direction: column; gap: 8px;">

  <div style="font-size: 19px; font-weight: 700; line-height: 1.15; flex: 1; display: flex; align-items: center;">
    {{ verdict }}
  </div>

  <div style="display: flex; flex-direction: row; flex-wrap: wrap; gap: 6px;">
    {% if storm.expected %}
      <div style="background: #000000; color: #ffffff; padding: 3px 8px; font-size: 11px;">
        Storms
      </div>
    {% endif %}
    <div style="border: 1px solid #000; padding: 3px 8px; font-size: 11px;">
      Feels {{ feels_like.low_f | round }}–{{ feels_like.high_f | round }}&deg;F
    </div>
    {% if flag != "white" %}
      <div style="background: {{ f_bg }}; color: {{ f_fg }}; padding: 3px 8px; font-size: 11px;">
        WBGT {{ flag | capitalize }}
      </div>
    {% endif %}
    {% if air_quality.show %}
      <div style="border: 1px solid #000; padding: 3px 8px; font-size: 11px;">
        AQI {{ air_quality.aqi | round }}
      </div>
    {% endif %}
    {% if wind.windy %}
      <div style="border: 1px solid #000; padding: 3px 8px; font-size: 11px;">
        Windy
      </div>
    {% endif %}
    {% if sun.show %}
      <div style="border: 1px solid #000; padding: 3px 8px; font-size: 11px;">
        UV {{ sun.uv_index | round }}
      </div>
    {% endif %}
    {% if rain.action != "none" %}
      <div style="border: 1px solid #000; padding: 3px 8px; font-size: 11px;">
        {{ rain.max_pop_pct | round }}% rain
      </div>
    {% endif %}
  </div>

</div>
