<!--
  Full (800x480 physical): daily weather briefing, decisions-first.
  Tier 1 = the verdict line (large, the thing to actually read). Tier 2 =
  small gated supporting chips -- only the metrics that crossed their
  threshold get a chip; calm/benign readings render nothing, by design
  (see Eos/docs/WEATHER_BRIEFING.md, "threshold-gated" principle).
-->

{% assign flag = work.flag %}
{% if flag == "black" %}
  {% assign f_bg = "#000000" %}{% assign f_fg = "#ffffff" %}
{% elsif flag == "red" %}
  {% assign f_bg = "#595959" %}{% assign f_fg = "#ffffff" %}
{% elsif flag == "yellow" %}
  {% assign f_bg = "#a6a6a6" %}{% assign f_fg = "#000000" %}
{% elsif flag == "green" %}
  {% assign f_bg = "#d9d9d9" %}{% assign f_fg = "#000000" %}
{% else %}
  {% assign f_bg = "#ffffff" %}{% assign f_fg = "#000000" %}
{% endif %}

<div class="view view--full" style="width: 100%; height: 100%; box-sizing: border-box; padding: 32px; font-family: sans-serif; display: flex; flex-direction: column; gap: 28px;">

  <div style="font-size: 52px; font-weight: 700; line-height: 1.15;">
    {{ verdict }}
  </div>

  <div style="display: flex; flex-direction: row; flex-wrap: wrap; gap: 14px;">
    {% if storm.expected %}
      <div style="background: #000000; color: #ffffff; padding: 10px 18px; font-size: 18px;">
        Storms{% if storm.window_label %}, {{ storm.window_label }}{% endif %}
      </div>
    {% endif %}
    <div style="border: 1px solid #000; padding: 10px 18px; font-size: 18px;">
      Feels {{ feels_like.low_f | round }}–{{ feels_like.high_f | round }}&deg;F
    </div>
    {% if flag != "white" %}
      <div style="background: {{ f_bg }}; color: {{ f_fg }}; padding: 10px 18px; font-size: 18px;">
        WBGT {{ flag | capitalize }} ({{ work.wbgt_f | round }}&deg;F)
      </div>
    {% endif %}
    {% if wind.windy %}
      <div style="border: 1px solid #000; padding: 10px 18px; font-size: 18px;">
        Windy, gusts {{ wind.gust_mph | round }}mph
      </div>
    {% endif %}
    {% if sun.show %}
      <div style="border: 1px solid #000; padding: 10px 18px; font-size: 18px;">
        UV {{ sun.uv_index | round }}
      </div>
    {% endif %}
    {% if rain.action != "none" %}
      <div style="border: 1px solid #000; padding: 10px 18px; font-size: 18px;">
        {{ rain.max_pop_pct | round }}% rain{% if rain.window_label %}, {{ rain.window_label }}{% endif %}
      </div>
    {% endif %}
  </div>

  <div style="font-size: 13px; opacity: 0.5; margin-top: auto;">
    updated {{ generated_at | date: "%-I:%M %p" }}
  </div>
</div>
