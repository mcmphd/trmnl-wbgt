<!--
  Three answers, not a metric. Severity styling is driven by the numeric
  fields (minutes_per_hour, uv_index) rather than string-matching labels --
  more robust, and keeps the design logic in one place instead of two.

  TRMNL hardware is grayscale e-ink -- severity is encoded as fill
  lightness (dark = worse), an ordinal channel for an ordinal variable,
  not a fake color system the screen can't render anyway.
-->

<div class="view view--full" style="padding: 24px; font-family: sans-serif; display: flex; flex-direction: column; gap: 18px;">

  <!-- WORK OUTSIDE -->
  {% assign wmin = work.minutes_per_hour %}
  {% if wmin == 60 %}
    {% assign w_bg = "#ffffff" %}{% assign w_fg = "#000000" %}{% assign w_border = "2px solid #000" %}
  {% elsif wmin == 45 %}
    {% assign w_bg = "#d9d9d9" %}{% assign w_fg = "#000000" %}{% assign w_border = "none" %}
  {% elsif wmin == 30 %}
    {% assign w_bg = "#a6a6a6" %}{% assign w_fg = "#000000" %}{% assign w_border = "none" %}
  {% elsif wmin == 15 %}
    {% assign w_bg = "#595959" %}{% assign w_fg = "#ffffff" %}{% assign w_border = "none" %}
  {% else %}
    {% assign w_bg = "#000000" %}{% assign w_fg = "#ffffff" %}{% assign w_border = "none" %}
  {% endif %}

  <div style="background: {{ w_bg }}; color: {{ w_fg }}; border: {{ w_border }}; padding: 18px 22px;">
    <div style="font-size: 13px; letter-spacing: 0.08em; opacity: 0.75; text-transform: uppercase;">
      Work Outside
    </div>
    {% if work %}
      <div style="font-size: 40px; font-weight: 700; line-height: 1.1;">
        {% if wmin == 60 %}Work freely
        {% elsif wmin == 0 %}Don't
        {% else %}{{ wmin }} min/hr{% endif %}
      </div>
      <div style="font-size: 15px; opacity: 0.8; margin-top: 2px;">
        WBGT {{ work.wbgt_f | round }}&deg;F
      </div>
    {% else %}
      <div style="font-size: 24px; opacity: 0.6;">No data</div>
    {% endif %}
  </div>

  <!-- RAIN -->
  <div style="border: 1px solid #000; padding: 16px 22px;">
    <div style="font-size: 13px; letter-spacing: 0.08em; opacity: 0.75; text-transform: uppercase;">
      Rain, Next {{ rain.window_hours }}h
    </div>
    {% if rain %}
      <div style="font-size: 30px; font-weight: 700; margin-top: 2px;">
        {% if rain.bring_umbrella %}Bring umbrella{% else %}No umbrella needed{% endif %}
      </div>
      <div style="font-size: 15px; opacity: 0.8;">
        {{ rain.max_pop_pct | round }}% chance
        {% if rain.frozen_only %}&middot; snow, not rain{% endif %}
      </div>
    {% else %}
      <div style="font-size: 24px; opacity: 0.6;">No data</div>
    {% endif %}
  </div>

  <!-- SUN -->
  <div style="border: 1px solid #000; padding: 16px 22px;">
    <div style="font-size: 13px; letter-spacing: 0.08em; opacity: 0.75; text-transform: uppercase;">
      Sun Protection
    </div>
    {% if sun %}
      <div style="font-size: 26px; font-weight: 700; margin-top: 2px;">
        {{ sun.label }}
      </div>
      <div style="font-size: 15px; opacity: 0.8;">
        UV Index {{ sun.uv_index | round }}
      </div>
    {% else %}
      <div style="font-size: 24px; opacity: 0.6;">No data</div>
    {% endif %}
  </div>

  <div style="font-size: 12px; opacity: 0.5;">
    updated {{ generated_at | date: "%-I:%M %p" }}
  </div>
</div>
